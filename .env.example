# Flask
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL connection URL (optional — when unset, uses SQLite at birthdays.db
# next to app.py, i.e. /home/container/birthdays.db on Pterodactyl)
# Example: postgresql://user:password@localhost:5432/happybirthday
DATABASE_URL=

# SMTP email settings (optional — if not set, emails print to stdout)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=HappyBirthday <your-email@gmail.com>

# Owner email (receives admin access codes and notifications)
OWNER_EMAIL=owner@example.com
