# Flask configuration
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL connection URL (optional — when unset, uses SQLite at birthdays.db
# next to app.py, i.e. /home/container/birthdays.db on Pterodactyl)
# Example: postgresql://user:password@localhost:5432/happybirthday
DATABASE_URL=

# Owner email (receives admin access codes and notifications)
OWNER_EMAIL=owner@example.com

# ---------------------------------------------------------------------------
# SMTP Email Settings
# If not configured, emails will be printed to stdout.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=HappyBirthday <your-email@gmail.com>
SMTP_TIMEOUT=10
SMTP_USE_TLS=true

# Common SMTP Provider Examples:
#
# 1. Gmail:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587 (or 465 for SSL)
#    SMTP_USER=your-email@gmail.com
#    SMTP_PASS=<16-character-app-password> (generate at: https://myaccount.google.com/apppasswords)
#
# 2. Seznam.cz / Email.cz:
#    SMTP_HOST=smtp.seznam.cz
#    SMTP_PORT=465
#    SMTP_USER=your-email@seznam.cz
#    SMTP_PASS=your-password-or-app-password
#
# 3. Microsoft 365 / Outlook:
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_USER=your-email@outlook.com
#    SMTP_PASS=your-password-or-app-password
